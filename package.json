{
  "name": "brightpearl-taxjar-extension",
  "version": "2.0.0",
  "description": "Brightpearl TaxJar Chrome Extension - Enterprise Package",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "build:dev": "node scripts/build.js --env=dev",
    "build:prod": "node scripts/build.js --env=prod",
    "package": "npm run build:prod && node scripts/package.js",
    "package:crx": "npm run build:prod && node scripts/package-crx.js",
    "clean": "rm -rf dist releases"
  },
  "devDependencies": {
    "archiver": "^7.0.0",
    "crx3": "^1.1.3",
    "fs-extra": "^11.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
